# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Database ──────────────────────────────────────────────────────────
# Local dev (default): embedded Postgres in .data/, nothing to install.
DATABASE_URL=pglite://.data/db
# Production: any Postgres, e.g. Neon free tier (use the *pooled* connection string)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# ── Email (Resend free tier) ──────────────────────────────────────────
# Leave empty to print emails to the server console.
RESEND_API_KEY=
EMAIL_FROM="NextForge <onboarding@resend.dev>"

# ── Storage ───────────────────────────────────────────────────────────
# local = files in .data/storage (dev) · s3 = Cloudflare R2 / any S3-compatible bucket
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
